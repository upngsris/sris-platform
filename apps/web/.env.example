# Copy to .env.local for development. In production set these in the hosting
# dashboard (never commit real values). See docs/deployment.md.

# ── Site ────────────────────────────────────────────────────────────────────
# The public address, no trailing slash. Used for canonical URLs, the sitemap
# and social previews. Required in production.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ── Sanity (content) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=1emtwm5v
NEXT_PUBLIC_SANITY_DATASET=production

# PRIVATE dataset for personal data: member profiles, payment references and
# contact enquiries. The public dataset above can be read by anyone through
# Sanity's API, so nothing personal is ever written to it. Create this once:
#   npx sanity dataset create private-records --visibility private
# The site refuses to store anything if this is unset, equals the public
# dataset, or turns out to be publicly readable. See docs/membership.md.
SANITY_PRIVATE_DATASET=private-records

# Token with *Editor* permission, server only. It writes to (and reads from)
# the private dataset. Create it at sanity.io/manage -> API -> Tokens.
SANITY_API_WRITE_TOKEN=

# Secret that makes member identifiers and renewal links unguessable. At
# least 32 characters; generate with:  openssl rand -base64 48
# Changing it later breaks existing renewal links and duplicate detection for
# members already registered, so set it once and keep it.
MEMBERSHIP_SECRET=

# Who is told about each new registration or renewal, to approve the payment.
# Defaults to CONTACT_TO when empty. One address or a comma-separated list.
MEMBERSHIP_NOTIFY_TO=

# Shared secret that signs the publish webhook. Generate one with:
#   openssl rand -base64 32
# Enter the same value when creating the webhook in Sanity.
SANITY_REVALIDATE_SECRET=

# ── Contact form email (Resend, https://resend.com) ─────────────────────────
# The contact form and membership registration email the team (and email
# applicants a confirmation). Email needs all three; leave them blank to
# disable it.
RESEND_API_KEY=
# A sender on a domain you have verified in Resend.
CONTACT_FROM="SRIS Website <no-reply@your-domain.example>"
# Who is notified. One address or several separated by commas. Replying to the
# email answers the visitor directly.
CONTACT_TO=sris@your-domain.example

# ── Operations ──────────────────────────────────────────────────────────────
# Set to "true" to serve the maintenance page (503) for every page.
MAINTENANCE_MODE=false

# Leave unset in production. When "true" it exposes /status-test/* URLs that
# deliberately trigger each error page.
ENABLE_STATUS_TEST_ROUTES=
